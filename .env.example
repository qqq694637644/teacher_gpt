# Teaching GPT application
TEACHING_GPT_LOCATOR_INDEX_PATH=./catalog/dip4e/compiled_locator_index.json
TEACHING_GPT_EXERCISE_INDEX_PATH=./catalog/dip4e/compiled_exercise_index.json
TEACHING_GPT_API_KEY=replace-with-a-long-random-secret
TEACHING_GPT_REQUIRE_API_KEY=true
TEACHING_GPT_CORS_ALLOW_ORIGINS=["*"]

# Skill catalog and vendored Skill runtime
SKILL_TEMPLE_SKILLS_DIR=./skills
SKILL_TEMPLE_SERVER_URL=https://YOUR_DOMAIN
# Optional when the vendored Skill runtime is used standalone.
# The integrated /v1/* routes in this project use TEACHING_GPT_API_KEY.
# SKILL_TEMPLE_BEARER_TOKEN=replace-with-a-long-random-secret

# Persistent workspace storage and PowerShell runtime
WORKSPACE_ROOT=./workspaces
WORKSPACE_OPERATION_ROOT=./workspaces/.operations
WORKSPACE_PWSH_PATH=pwsh

# workspaceCommand sync-first behavior and operation limits
# How long action="start" waits for a quick command before returning a running operation_id.
WORKSPACE_COMMAND_SYNC_WAIT_SECONDS=5
# Default and maximum total command runtime in seconds.
WORKSPACE_COMMAND_TIMEOUT_SECONDS=120
WORKSPACE_COMMAND_MAX_TIMEOUT_SECONDS=3600
# Default and maximum captured stdout/stderr bytes per operation.
WORKSPACE_COMMAND_OUTPUT_BYTES=1000000
WORKSPACE_COMMAND_MAX_OUTPUT_BYTES=10000000
